# If unset, defaults to anthropic:claude-sonnet-4-6 (see graph.py).
GRILLD_AI_MODEL=anthropic:claude-sonnet-4-6

# Required - all LLM calls happen in this service, never in Spring Boot
# (docs/decisions-and-technical-architecture.md §11).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Same Postgres instance grilld-backend uses (docker-compose.yml at the repo
# root). This service only ever writes to its own checkpoint tables, never
# Spring's business schema - see app.py and
# docs/decisions-and-technical-architecture.md §11.2.
DATABASE_URL=postgresql://grilld:grilld_dev_only@localhost:5432/grilld

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...

# Required from Phase 5 on - Market Analyst, Competition Analyst, Tech
# Architect, and Infra Agent all use live web search. Free tier at
# tavily.com covers 1,000 searches/month, plenty for dev.
TAVILY_API_KEY=tvly-...

# Optional - a genuinely free (rate-limited, not credit-limited) alternative
# to ANTHROPIC_API_KEY for local testing, especially the expensive full
# 10-agent roster run (tests/integration_tests/test_graph.py). Get a key at
# console.groq.com, then set GRILLD_AI_MODEL=groq:llama-3.3-70b-versatile -
# every graph reads that env var, so this is a config swap, no code change.
# Structured output (.with_structured_output()) is only reliable on a subset
# of Groq's models - llama-3.3-70b-versatile is a safe one; don't assume
# every Groq model supports it.
GROQ_API_KEY=gsk_...
