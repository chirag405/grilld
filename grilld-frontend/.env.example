# Copy to .env.local and fill in for your environment. See docs/phases/phase-9/SETUP.md.

# grilld-backend's own origin - used server-side (Server Components, the /api/proxy
# Route Handler) to call the API directly.
BACKEND_API_URL=http://localhost:8080

# Same value, exposed to the browser (NEXT_PUBLIC_ prefix) - only used to build the
# "Sign in with Google" link, which is a full-page redirect to the backend's OAuth2
# endpoint, not an API call. Never put anything secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
